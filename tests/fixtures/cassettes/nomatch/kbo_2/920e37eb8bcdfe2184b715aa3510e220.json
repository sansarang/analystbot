\r\n\t\t<!-- s:소개 -->\r\n<!--\r\n\t\t<div class=\"introManager\">\r\n\t\t\t<div class=\"hd\">\r\n\t\t\t\t<div class=\"tit\">\r\n\t\t\t\t\t<h3>빠른 발과 수비력을 갖춘 외야 유틸리티</h3>\r\n\t\t\t\t</div>\r\n\t\t\t\t\r\n\t\t\t\t<div class=\"score\">\r\n\t\t\t\t\t<strong class=\"t\">2026시즌 </strong>\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t\t\t\t\t<span class=\"d\">타율<em>0.000</em></span>\r\n\t\t\t\t\t\t<span class=\"w\">안타<em>0</em></span>\r\n\t\t\t\t\t\t<span class=\"l\">타점<em>0</em></span>\r\n\t\t\t\t\t\t<span class=\"s\">홈런<em>0</em></span>\r\n\t\t\t\t\t\t<!--<span class=\"d\">도루 <em>0</em></span>\t\t\t\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\r\n\t\t\t\t</div>\r\n\t\t\t\t<span class=\"mBtn1t2 line btnDetail\"></span>\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t</div>\r\n\t\t\t\r\n\t\t\t<div class=\"bd\">\r\n\t\t\t\t<p>\r\n\t\t\t\t\t홍현빈은 유신고 시절부터 스카우트들의 주목을 받았던 외야수로, 2017년 프로입단하여 2025년 삼성 라이온즈에 합류했다.\r\n\r\n빠른 발과 강한 어깨를 바탕으로 한 뛰어난 수비 능력이 최대 강점이다. 타격에서는 기본적으로 눈야구가 가능하여 타율보다 1할 높은 출루율을 기록하며, 컨택이 좋아 테이블 세터로의 발전이 기대된다. 또한 대주자와 대수비로서 팀에 기여하는 역할을 충실히 수행하며, 적극적인 주루플레이로 찬스 메이킹에도 능하다.\r\n\r\n2025년 삼성 라이온즈 스프링캠프에서 외야수 부문 MVP로 선정되며 새로운 팀에서의 기대를 모으고 있다.\t\t\t\t\t\r\n\t\t\t\t\t<span class=\"mBtn1t2 line\"></span>\r\n\t\t\t\t</p>\r\n\r\n\t\t\t</div>\r\n\t\t\t<div style=\"float:right;margin:5px;20px 0 0;\">\r\n\t\t\t\t\r\n\t\t\t</div>\r\n\t\t</div>\r\n-->\t\t\r\n\t\t\r\n<!--\t\t\t\t\r\n\t\t<div class=\"introManager\">\r\n\t\t\t<div class=\"hd\">\r\n\t\t\t\t<div class=\"tit\">\r\n\t\t\t\t\t<h3>빠른 발과 수비력을 갖춘 외야 유틸리티</h3>\r\n\t\t\t\t</div>\r\n\t\t\t\t<div class=\"score\">\r\n\t\t\t\t\t<strong class=\"t\">2026시즌 성적</strong>\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t\t\t\t\t<span class=\"d\">타율<em>0.000</em></span>\r\n\t\t\t\t\t\t<span class=\"w\">안타<em>0</em></span>\r\n\t\t\t\t\t\t<span class=\"l\">타점<em>0</em></span>\r\n\t\t\t\t\t\t<span class=\"s\">홈런<em>0</em></span>\r\n\t\t\t\t\t\t<span class=\"d\">도루 <em>0</em></span>\t\t\t\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\r\n\t\t\t\t</div>\r\n\t\t\t\t<span class=\"m