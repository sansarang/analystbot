tPaths) && header === null;\n          var headerSmall = webview || header === 'simple' || headerSimpleByDefault || isSmall;\n\n          // 라우트가 staticData.appNudge: false를 선언한 경로\n          var nudgeHiddenPaths = [\n            '/withdraw',\n            '/identification',\n            '/confirm-identification',\n            '/settings',\n            '/points',\n            '/referral',\n            '/media-viewer',\n            '/business-information',\n            '/sell-to-love',\n          ];\n          var nudgeHidden =\n            webview ||\n            matchesPath(nudgeHiddenPaths) ||\n            params.get('appNudge') === 'false' ||\n            params.get('disable_landing_modal') === 'true';\n\n          var parts = [];\n          if (!headerHidden) {\n            parts.push(headerSmall ? 'var(--header-height-small)' : 'var(--header-height-large)');\n          }\n          if (!nudgeHidden) {\n            parts.push(isSmall ? 'var(--app-nudge-banner-height-small)' : 'var(--app-nudge-banner-height-large)');\n          }\n\n          if (parts.length > 0) {\n            document.documentElement.style.setProperty(\n              '--app-shell-top-reserve',\n              parts.length === 1 ? parts[0] : 'calc(' + parts.join(' + ') + ')'\n            );\n          }\n        } catch (error) {\n          // 예약에 실패하면 기존처럼 실측만으로 동작한다 (첫 페인트 후 시프트 1회)\n        }\n      })();\n    </script>\n\n    <script type=\"application/ld+json\">\n      {\n        \"@context\": \"http://schema.org\",\n        \"@type\": \"Organization\",\n        \"name\": \"번개장터\",\n        \"url\": \"https://m.bunjang.co.kr\",\n        \"sameAs\": [\n          \"https://www.instagram.com/bgjtmag\",\n          \"https://play.google.com/store/apps/details?id=kr.co.quicket&hl=ko\",\n          \"https://apps.apple.com/kr/app/id395672275\"\n        ]\n      }\n    </script>\n    <script type=\"module\" crossorigin src=\"/static/js/index.CBooO9ba.js\"></script>\n    <link rel=\"modulepreload\" cr