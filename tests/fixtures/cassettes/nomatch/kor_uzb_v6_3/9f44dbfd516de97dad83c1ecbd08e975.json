rns into production chains, investments and jobs,&quot; Uzbekistan Ambas...\" />\r\n<meta property=\"twitter:card\" content=\"summary_large_image\" />\r\n<meta property=\"article:author\" content=\"Park Sae-jin\">\r\n<meta property=\"article:published_time\" content=\"2026-03-05T14:02:45+09:00\">\r\n<meta property=\"article:modified\" itemprop=\"dateModified\" content=\"2026-03-05T14:40:44+09:00\" />\r\n<meta property=\"article:section\" content=\"News\" />  <!-- 메인 카테고리 (필수) -->\r\n<meta property=\"dd:content_id\" content=\"20260305135710735\" />\r\n<meta property=\"dd:author\" content=\"Park Sae-jin\"/>\r\n<meta property=\"dd:category\" content=\"News\" />  <!-- 메인 카테고리 (필수) -->\r\n<meta property=\"dd:published_time\" content=\"2026-03-05T14:02:45+09:00\" />  \r\n<meta property=\"dd:modified_time\" content=\"2026-03-05T14:40:44+09:00\" />\r\n<meta property=\"dd:playtime\" content=\"\" />  \r\n<meta property=\"dd:publisher\" content=\"Park Sae-jin\" />\r\n<meta property=\"dd:availability\" content=\"true\" />\r\n<meta name=\"keywords\" content=\"critical minerals,high-speed rail,uzbekistan-2030\">\r\n<link rel=\"amphtml\" href=\"https://m.ajupress.com/amp/20260305135710735\" />\r\n<!-- common head start -->\r\n<meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\" />\r\n<meta http-equiv=\"Content-Language\" content=\"ko\" />\r\n<meta http-equiv=\"Content-Type\" content=\"text/html;charset=UTF-8\" />\r\n<meta http-equiv=\"Content-Security-Policy\" content=\"upgrade-insecure-requests\"/>\r\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=5.0, minimum-scale=1.0, user-scalable=yes\">\r\n\r\n<link rel=\"canonical\" href=\"https://www.ajupress.com/view/20260305135710735\" />\r\n<link rel=\"shortcut icon\" type=\"image/x-ico\" href=\"https://image.ajunews.com/images/site/ajupress/img/favicon.ico\" />\r\n<link rel=\"alternate\" media=\"only screen and ( max-width: 640px)\" href=\"https://m.ajupress.com/view/20260305135710735\" />\r\