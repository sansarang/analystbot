     // toggleForm\r\n        function toggleForm(id) {\r\n            const form = document.getElementById(id);\r\n            form.style.display = (form.style.display === \"none\" || form.style.display === \"\") ? \"block\" : \"none\";\r\n        }\r\n\r\n        // 메세지 \r\n        function confirmNavigation(url) {\r\n            if (confirm(\"정말 이 페이지로 이동하시겠습니까?\")) {\r\n                // 확인 -> 이동\r\n                window.location.href = url;\r\n                return false;\r\n            }\r\n            // 취소 -> 아무 동작 안 함\r\n            return false;\r\n        }\r\n        // gethint hash-tag 수정\r\n        // AJAX로 동적 로드되는 페이지이므로 DOMContentLoaded를 사용하지 않고 문서 전체(document)에서 이벤트를 감지합니다.\r\n        document.addEventListener(\"click\", function(e) {\r\n            // 클릭된 요소가 .editable 이거나 .editable의 자식 요소인지 확인합니다.\r\n            const cell = e.target.closest(\".editable\");\r\n\r\n            // .editable 요소가 아니거나, 이미 내부에 input이 만들어져 있다면 무시합니다.\r\n            if (!cell || cell.querySelector(\"input\")) return;\r\n\r\n            // 앞뒤 공백으로 인한 데이터 매칭 오류를 방지하기 위해 trim()을 추가합니다.\r\n            const oldValue = cell.textContent.trim();\r\n            const field = cell.dataset.field;\r\n            const id = cell.dataset.id;\r\n\r\n            const input = document.createElement(\"input\");\r\n            input.type = \"text\";\r\n            input.value = oldValue;\r\n            input.style.width = \"100%\";\r\n            input.className = \"form-control form-control-sm\";\r\n\r\n            cell.innerHTML = \"\";\r\n            cell.appendChild(input);\r\n            input.focus();\r\n            input.select(); // 전체 선택 (편의성)\r\n\r\n            // Enter 키 지원\r\n            input.addEventListener(\"keydown\", function(e) {\r\n                if (e.key === \"Enter\") {\r\n                    e.preventDefault();\r\n                    this.blur();\r\n                } else if (e.key === \"Escape\") {\r\n                    e.preventDefault();\r\n                    cell.innerHTML = oldValue; // 취소 → 원래 값으로 복구\r\n                }\r\n            });\r\n\r\n            // blur 이벤트는 동적으로 생성된 input 객체에 직접 안전하게 바인딩합니다.\r\n            input.addEventListener(\"blur\", function() {\r\n                const newValue = input.value.trim();\r\n\r\n                // ESC로 취소한 경우 blur이 발생해도 저장하지 않음\r\n                if (cell.innerHTML === oldValue) return; // 이미 ESC로 복구된 상태\r\n\r\n                if (newValue !== oldValue) {\r\n                    fetch(\"update_cell.php\", {\r\n                            method: \"POST\",\r\n                            headers: {\r\n                                \"Content-Type\": \"application/x-www-form-urlencoded\",\r\n                            },\r\n                            body: `id=${id}&field=${field}&value=${encodeURIComponent(newValue)}`\r\n                        })\r\n                        .then(res => res.text())\r\n                        .then(() => {\r\n                            cell.innerHTML = newValue;\r\n                        })\r\n                        .catch(err => {\r\n                            console.error(\"오류 발생:\", err);\r\n                            cell.innerHTML = oldValue;\r\n                        });\r\n                } else {\r\n                    cell.innerHTML = oldValue;\r\n                }\r\n            });\r\n        });\r\n    </script>\r\n    <div style=\"position:fixed;bottom:150px;right:30px;\" class=\"d-none d-sm-block\"><a href=\"#top\"><i class=\"bi bi-arrow-up-circle\" style=\"font-size: 3rem;\"></i></a></div></body>\r\n\r\n</html>",
 "reason": ""
