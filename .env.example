# AnalystBot v4 — 환경변수
#
# 🔴 **코드가 실제로 읽는 것만 여기 있다.** 없는 키를 적어 두면 다음 세션이
#    지워진 코드를 설정하려 한다 — 실측 2026-09-27: Anthropic·PPLX·XAI·ODDS·
#    APIFOOTBALL 키와 모델 이름 8개가 남아 있었고 그 코드는 전부 지워진
#    상태였다. 계약 `test_env_example_이_코드와_맞는다` 가 이것을 잠근다.
# 🔴 **유료 API 0건**(§14-13). §19-i-1 정의: 카드 미등록·과금 0·무료 플랜
#    상한 안에서 도는 키는 유료가 아니다. 카드 등록이 필수면 무료 플랜이
#    있어도 제외.
# 🔴 키가 없으면 그 모듈은 목 모드로 돈다 — **키 부재로 크래시하지 않는다.**

# PostgreSQL. `docker compose up -d postgres`
DATABASE_URL=postgresql://analyst:analyst@localhost:5432/analystbot

# 축구 일정 (football-data.org 무료 티어)
FOOTBALL_DATA_KEY=

# 위와 한 쌍. 없으면 그 칸을 비운 채 SearXNG 만으로 돈다
GOOGLE_CSE_CX=

# 🔴 **비용 잠금**(사용자 지시 2026-09-28). 결제 계정 미연결 또는 할당량
#    100/일 고정을 콘솔에서 확인한 뒤에만 켠다. 꺼져 있으면 운영 스케줄러가
#    CSE 를 **붙이지 않는다** — SearXNG 만으로 돈다.
#    ⚠️ 할당량은 **태평양 시간(PT) 자정**에 돌아온다. KST 로 세면 하루가 어긋난다.
CSE_OPERATIONAL=false

# §19-i 2순위. 무료 100/일 · **카드 등록 불필요**. 반증·라인업에만
GOOGLE_CSE_KEY=

# 호출 고정 seed. 온도 0 · JSON Schema 강제(§17-g-1)
LLM_SEED=7

# 🔴 LLM 은 여기 하나다(§17-a). 로컬 Ollama
OLLAMA_BASE_URL=http://localhost:11434

# 기본 추출 모델(§17-a). 비영어 기사 비중이 커서 Qwen 이다
OLLAMA_MODEL=qwen3:8b

# 가벼운 분류만. 🔴 추출엔 안 쓴다
OLLAMA_MODEL_LIGHT=llama3.2:1b

# ══════════════════════════════════════════════════════════════════
# 🔴🔴 **Solar(Upstage)** — v5 §0 이 유료 0건 규칙을 **하나만** 열었다
# ══════════════════════════════════════════════════════════════════
#
#  v5 §0: *"「유료 API·MCP·커넥터 0건」은 **Upstage Solar API 하나만** 예외로
#  바꾼다. 다른 유료 서비스는 여전히 0건이다. 결제는 사용자가 Upstage 콘솔
#  (console.upstage.ai)에서 직접 하고, 봇은 §2 의 예산 가드로 그 한도 안에서만
#  돈다."*
#
#  🔴 §2: *"키는 console.upstage.ai/api-keys 에서 발급, **로컬 `.env` 에만** 둔다.
#     이름은 `.env.example` 에만(**값 금지**)."* — 그래서 여기는 빈칸이다.
#  ⚠️ **다른 유료 키가 `.env` 에 들어오면 실패**(기존 계약 유지 · §2).
#  🔴 한도·단가는 `config/llm.yaml` 이다(§2 *"값은 거기 두고 사용자만 바꾼다"*).
UPSTAGE_API_KEY=

# Redis (선택)
REDIS_URL=

# 🔴 §19-i 1순위. 비용 0 · 키 없음 · 상한 없음. **루프백만**
SEARXNG_URL=http://127.0.0.1:8888

# 🔴 발송 스위치. **사용자만 켠다.** 기본 꺼짐
SEND_ENABLED=false

# 🔴🔴 **v5 게이트 2 — §3 에이전트.** 켜면 **Solar 비용이 발생한다**
#    (§2 예산: 경기당 입력 150k·출력 20k · 하루 $3 · 월 $40).
# ⚠️ 코드가 혼자 켜지 않는다 — 사용자만 켠다.
AGENT_ENABLED=false

# 운영 알림 채팅 ID
TELEGRAM_ADMIN_CHAT_ID=

# 봇 토큰 (@BotFather). 없으면 목 모드 — 크래시하지 않는다
TELEGRAM_BOT_TOKEN=

# ── 배포 플랫폼이 주입한다 (우리가 안 적는다) ────────────────────
# 컨테이너 이미지에는 `.git` 이 없어 커밋 해시를 git 으로 못 읽는다.
# `app/version.py` 가 이 값을 1순위로 본다 — /health 의 커밋 대조가 그것이다.
#   GIT_COMMIT_SHA · RAILWAY_GIT_COMMIT_MESSAGE · RAILWAY_GIT_COMMIT_SHA · SOURCE_COMMIT

# ── 카세트 (v4 §9 단계 3 게이트) ──────────────────────────────────
# 🔴 §19-g 는 *"실제 네트워크 없이 저장된 응답으로 재현"* 을 요구한다.
#    off(기본)=그냥 네트워크 · record=가서 저장 · replay=네트워크에 안 간다.
#    ⚠️ replay 에서 카세트가 없으면 **없다고 적는다** — 몰래 라이브로 가지 않는다.
CASSETTE_MODE=off

# 어느 날 카세트인가. 비우면 오늘(KST). §19-g 실측은 2026-09-27 이다
CASSETTE_DAY=

# 카세트가 사는 곳. 비우면 tests/fixtures/cassettes
CASSETTE_DIR=

# 🔴 **측정용 시계** (단계 4). 검증기가 "지금"으로 삼을 날짜를 못 박는다.
#    비면 **진짜 지금**이다 — 운영은 반드시 비워 둔다.
#    ⚠️ §9 가 "경기 전 시점 웹에서 재현"을 요구하므로 측정 스크립트가 건마다
#       그 경기 날짜를 넣는다. 날짜 검증을 느슨하게 하는 것이 아니다 —
#       기준 시각만 옮기고, 그 시각에서 오래된 기사는 여전히 거부된다.
CASSETTE_AS_OF=

# ══════════════════════════════════════════════════════════════════
# 🔴🔴 **실행 단위 카세트** — 지시서 2026-10-06 §5
# ══════════════════════════════════════════════════════════════════
#
# > 저장 위치 `cassettes/{경기 id}/{실행 id}/`, 요청 해시 → 응답.
#
# 🔴 왜 — 2026-10-06 에 하루 예산 $5 중 **$4.88** 을 수정 확인용 재실행에 썼다
#    (한 번에 $0.34 · 26분). 같은 입력으로 공짜로 확인할 수 있는 수정이었다.
# ⚠️ `CASSETTE_RUN` 이 **비어 있으면** 종전 날짜 칸(`{날짜}/`)으로 간다 —
#    녹음해 둔 고정물이 그대로 돌아야 한다(사본 금지).

# 어느 경기의 카세트인가(`fotmob:5181806`). 비우면 `nomatch`
CASSETTE_MATCH=

# 이 실행의 이름. 🔴 **비우면 실행 칸을 쓰지 않는다**(종전 날짜 칸)
CASSETTE_RUN=

# 🔴🔴 **재생인데 카세트에 없는 요청을 라이브로 보낼까** — 기본은 **아니다**.
#    ⚠️ 비면 `replay_miss` 로 **실패**한다(M134) — 몰래 라이브를 때리지 않는다.
#    🔴 켜면 없는 요청만 라이브로 가고 카세트에 **추가**된다(질의 규칙을 고친
#       뒤 검색만 라이브로 확인할 때 쓴다 · §5 표).
CASSETTE_FALLTHROUGH=

# 🔴🔴 **v5-A — DeepSeek**(가설·시나리오 + 반증).
# ⚠️ **이름만** 적는다 — 키는 로컬 `.env` 에만 둔다(v5-A §2).
DEEPSEEK_API_KEY=

# 🔴 배당 피드(네 층 §2-1) — **이름만** 적는다. 값은 `.env` 에.
#    the-odds-api 무료 등급 월 500 크레딧 · 카드 등록 없이 발급됐다(2026-10-06 실측).
ODDS_API_KEY=
#    oddspapi(월 250) — 아직 키 없음
ODDSPAPI_KEY=
#    odds-api.io — 🔴 **새 무료 키 발급이 멈춰 있다**(문서 실측 2026-10-06:
#    *"New free API keys are paused"*). 기존 키는 시간당 100·하루 500 으로 돈다.
#    ⚠️ 이 피드가 **대표팀 친선·CONCACAF·AFC** 를 덮는지는 **키를 받은 뒤** 잰다.
ODDS_API_IO_KEY=
