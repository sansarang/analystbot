# 키가 하나라도 없으면 해당 모듈은 mock_data/ 목 모드로 폴백한다 (크래시 금지).

TELEGRAM_BOT_TOKEN=          # 텔레그램 봇 토큰 (@BotFather)
TELEGRAM_ADMIN_CHAT_ID=      # API 크레딧/쿼터 소진 알림을 받을 채팅 ID
ANTHROPIC_API_KEY=           # Claude 판정(judge)·리포트·의도 파싱
PPLX_API_KEY=                # Perplexity sonar-pro 딥서치
XAI_API_KEY=                 # Grok Live Search (api.x.ai)
ODDS_API_KEY=                # The Odds API v4 (배당)
APIFOOTBALL_KEY=             # API-Football (축구 스탯)

JUDGE_MODEL=claude-opus-4-6  # 구 Judge(--old) 모델. 폼·매치업과 분리한다.
MODEL_TEAM_FORM=claude-haiku-4-5-20251001  # 야구 팀 경기력 분석 (프롬프트 1)
MODEL_MATCHUP=claude-sonnet-5              # 야구 매치업 판정 (프롬프트 2)
# 역할 모델을 **비워두지 마라.** 비면 provider.py 의 역할 폴백이 judge_model
# (=Opus)이나 report_model 을 대신 넣는다 — 모델이 조용히 바뀐다.
NARRATOR_MODEL=claude-sonnet-5             # 서술. 비우면 report_model 로 새어 간다
INTERPRETER_PROVIDER=anthropic             # 2단 해석(라인업 의도) — 비우면 역할이 꺼진다
INTERPRETER_MODEL=claude-haiku-4-5-20251001  # 비우면 폴백이 Opus를 넣는다. 호출량 최다 역할
JUDGE_A_PROVIDER=                          # 3단 대조 — 비활성

# 인프라 (docker-compose 기본값과 일치)
DATABASE_URL=postgresql://analyst:analyst@localhost:5432/analystbot
REDIS_URL=redis://localhost:6379

# [v1.1 6단계] 딥서치 조사 (판정이 막힌 경기만 web_search 로 보강)
# 트리거 판별·상한·기록·폴백은 이 값과 무관하게 항상 돈다.
# true 로 켜면 그 위에 **실제 조사 호출**이 붙는다 — 외부 비용이 발생한다.
DEEPSEARCH_ENABLED=false     # 운영은 true (2026-09-01 사용자 승인 후 활성)
DEEPSEARCH_DAILY_CAP=0.30    # 하루 발동 상한 = 슬레이트의 이 비율 (최소 1경기)
DEEPSEARCH_MAX_SEARCHES=5    # 경기당 검색 상한. 프롬프트의 [검색 예산]과 같은 값이다
DEEPSEARCH_TIMEOUT_SEC=120   # 한 경기 조사 제한시간. 넘으면 원판정 유지

# 전 모듈 강제 목 모드 (테스트/데모용)
FORCE_MOCK=false
